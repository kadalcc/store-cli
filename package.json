{
  "name": "@kadal/store",
  "version": "0.1.0",
  "description": "The Kadal Store from your terminal and your AI agent: search the shop, get recommendations for the project you are in, download and sync what you own, and get a buy link to review. A CLI and a local MCP server.",
  "mcpName": "cc.kadal/store",
  "keywords": [
    "kadal",
    "store",
    "digital-downloads",
    "assets",
    "planners",
    "printables",
    "cli",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "claude"
  ],
  "homepage": "https://store.kadal.cc",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/pmithunish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kadalcc/store-cli.git"
  },
  "bugs": {
    "url": "https://github.com/kadalcc/store-cli/issues"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Kadal <hello@kadal.cc> (https://kadal.cc)",
  "type": "module",
  "files": [
    "dist",
    "skills",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "kadal-store": "dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test tools",
    "format": "oxfmt src test tools",
    "test": "bun test",
    "changeset": "changeset",
    "release": "bun run build && node tools/publish.mjs",
    "prepack": "tsdown"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^25.9.3",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3"
  }
}
